---
interface Props {
  title: string;
  // Optional ID for links or scripts that need to find this box.
  id?: string;
  // Start expanded when requested; existing uses stay collapsed by default.
  open?: boolean;
}

const { title, id, open = false } = Astro.props;
---

<details id={id} open={open}>
  <summary>{title}</summary>
  <div class="details-content">
    <slot />
  </div>
</details>

<style>
  details {
    margin-bottom: 0.5em;
    color: var(--default-text);
    border: 1px solid var(--card-border);
    background-color: var(--card-bg);
  }





  summary {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 0.5em 0.8em;
  cursor: pointer;
  background-color: var(--card-header);
  list-style: none;
  }

  summary:hover {
    background-color: var(--table-hover);
  }

  details[open] summary {
    border-bottom: 1px solid var(--card-border);
  }

  summary::after {
  color: var(--link-color);
  content: "Expand +";
  margin-left: auto;
  padding-left: 1em;
  white-space: nowrap;
  font-size: 0.85em;
  }

  summary:hover::after {
    color: var(--link-hover);
  }

  details[open] summary::after {
    content: "Collapse −";
  }

  .details-content {
    padding: 0em 1em;
  }
</style>
