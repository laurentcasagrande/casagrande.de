---
const { figure, alt, caption, copyright, id } = Astro.props;


import { Image } from 'astro:assets';

---

<figure id={id}>

  <Image 
  src={figure} 
  alt={alt} 
  loading="lazy"
  />

  <figcaption>
  {caption}

  {copyright && (
      <small class="copyright">
        © {copyright}
      </small>
    )}
  </figcaption>

</figure>



<style>
.copyright {
  display: block;
  margin-top: 0.25rem;
  font-size: 0.75rem;
  color: var(--default-text);
  opacity: 0.65;
}
</style>