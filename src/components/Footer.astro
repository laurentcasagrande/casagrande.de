---
const year = new Date().getFullYear();
---

<footer>
  <p>&copy; {year} LNC</p>
</footer>

<style>

footer {
  position: absolute;
  bottom: 0px;
  left: 5%;
  width: 90%;
  box-sizing: border-box;
  padding-bottom: 10px;
  overflow: hidden;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

footer p {
  margin: 0;
  line-height: 1em;
}

</style>