---
import Navigation from './Navigation.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header>
  <div class="header-title-row">
    <span aria-hidden="true"></span>

    <h1>Laurent Casagrande</h1>

    <ThemeToggle />
  </div>

  <hr class="no-vertical-margin">

  <nav>
    <Navigation />
  </nav>

  <hr>
  
</header>

<style>




header h1 {
  text-align: center;
  margin-top: 15px;
  margin-bottom: 20px;
  font-size: 3em;
  font-weight: 400;
  color: var(--header-title-text);
}

.header-title-row {
  display: grid;
  grid-template-columns: 4rem minmax(0, 1fr) 4rem;
  align-items: center;

  margin-inline: 5%;
  padding-block: 1rem;
}

.header-title-row h1 {
  grid-column: 2;
  margin: 0;
  text-align: center;
}



header hr {
  width: 90%;
  margin: auto;
    margin-bottom: auto;
  margin-bottom: 20px;
  border: none;
    border-bottom-width: medium;
    border-bottom-style: none;
    border-bottom-color: currentcolor;
  border-bottom: 1px solid var(--navbar-rule);
}

header hr.no-vertical-margin {
  margin-bottom: 0;
}

header nav {
  display: flex;
  flex-flow: row wrap;
  justify-content: space-around;
}


</style>