<canvas id="canvas" width="1000" height="1500"></canvas>

<button id="downloadGif"> Download GIF </button>

<p id="gifStatus"></p>

<script>
  import { encode } from "modern-gif";
  import workerUrl from "modern-gif/worker?url";

  //Physics Constants

  const radius = 40;
  //======================
  //Physics Engine
  //======================
  const V_sweep_displacer = 20;
  const V_sweep_Work = 1;
  const V_dead_h = 0;
  const V_dead_c = 0;

  const frequency = 0.15;
  const omega = frequency * (2* Math.PI);
  const R = 8.31446261815324;
  const n = 0.005;
  const T_h = 400;
  const T_c = 300;

  function Volume(DisplacerAngle, WorkAngle) {
    const V_Work = V_sweep_Work * (1-Math.sin(WorkAngle)) / 2;

    const V_h = V_dead_h + V_sweep_displacer * (1-Math.sin(DisplacerAngle)) / 2;
    const V_c = V_dead_c + V_Work + V_sweep_displacer * ((1+Math.sin(DisplacerAngle)) / 2);
    const V = V_h+V_c;
    return V;
  }

  function Pressure(DisplacerAngle, WorkAngle) {
    const V_Work = V_sweep_Work * (1-Math.sin(WorkAngle)) / 2;

    const V_h = V_dead_h + V_sweep_displacer * (1-Math.sin(DisplacerAngle)) / 2;
    const V_c = V_dead_c + V_Work + V_sweep_displacer * ((1+Math.sin(DisplacerAngle)) / 2);

    const p = n * R / ((V_c/T_c)+(V_h/T_h));
    return p;
  }
  
  const Volumes = [];
  const Pressures = [];

  for (let i = 0; i < 180; i++) {
    const DisplacerAngle = i*2/360*2*Math.PI;
    const WorkAngle = DisplacerAngle - Math.PI / 2;

    Volumes.push(Volume(DisplacerAngle, WorkAngle));
    Pressures.push(Pressure(DisplacerAngle, WorkAngle));
  }

  //======================
  //Animation
  //======================
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  function drawFrame(t) {
    const theta = (omega * t) % (2 * Math.PI);
    const alpha = (theta - Math.PI / 2) % (2 * Math.PI);
    const h_Displacer = Math.sin(theta) * radius;
    const h_Work = Math.sin(alpha) * radius;

    ctx.lineWidth = 5;

    ctx.fillStyle = "rgb(255 255 255)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    //Connecting rod Left
    ctx.lineWidth = 5;

    ctx.strokeStyle = "DarkMagenta";
    ctx.beginPath();

    ctx.moveTo(105, 220 - radius + h_Work);
    ctx.lineTo(105, h_Work + 700);

    ctx.stroke();

    ctx.lineWidth = 3;

    //Flywheel Left
    ctx.fillStyle = "lightBlue";
    ctx.fillRect(190, 20, 20, 400);
    ctx.strokeStyle = "blue";
    ctx.strokeRect(190, 20, 20, 400);

    ctx.lineWidth = 1;

    //Arrow Left
    ctx.strokeStyle = "Black";

    ctx.moveTo(200, 30);
    ctx.lineTo(200, 60);
    ctx.lineTo(195, 55);
    ctx.moveTo(200, 60);
    ctx.lineTo(205, 55);

    ctx.moveTo(200, 30 + 350);
    ctx.lineTo(200, 60 + 350);
    ctx.lineTo(195, 55 + 350);
    ctx.moveTo(200, 60 + 350);
    ctx.lineTo(205, 55 + 350);

    ctx.stroke();

    ctx.lineWidth = 5;

    //Connector Flywheel-rod Left
    ctx.strokeStyle = "DarkGreen";

    ctx.beginPath();

    ctx.moveTo(210, 220 - radius + h_Displacer);
    ctx.lineTo(223.75, 220 - radius + h_Displacer);

    ctx.stroke();

    ctx.strokeStyle = "DarkMagenta";
    ctx.beginPath();

    ctx.moveTo(190, 220 - radius + h_Work);
    ctx.lineTo(130 - 25, 220 - radius + h_Work);

    ctx.stroke();

    ctx.lineWidth = 3;

    //Flywheel Right
    ctx.strokeStyle = "blue";
    ctx.fillStyle = "lightBlue";

    ctx.beginPath();
    ctx.arc(771.25, 220, 200, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(771.25, 220, 180, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    ctx.lineWidth = 1;

    //Arrow Right

    ctx.strokeStyle = "Black";

    ctx.beginPath();
    ctx.arc(771.25, 220, 190, theta, theta + 0.15);
    ctx.moveTo(
      771.25 + Math.cos(theta + 0.15) * 190,
      220 + Math.sin(theta + 0.15) * 190,
    );
    ctx.lineTo(
      771.25 + Math.cos(theta + 0.1) * 185,
      220 + Math.sin(theta + 0.1) * 185,
    );

    ctx.moveTo(
      771.25 + Math.cos(theta + 0.15) * 190,
      220 + Math.sin(theta + 0.15) * 190,
    );
    ctx.lineTo(
      771.25 + Math.cos(theta + 0.1) * 195,
      220 + Math.sin(theta + 0.1) * 195,
    );
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(771.25, 220, 190, theta + Math.PI, theta + Math.PI + 0.15);
    ctx.moveTo(
      771.25 + Math.cos(theta + Math.PI + 0.15) * 190,
      220 + Math.sin(theta + Math.PI + 0.15) * 190,
    );
    ctx.lineTo(
      771.25 + Math.cos(theta + Math.PI + 0.1) * 185,
      220 + Math.sin(theta + Math.PI + 0.1) * 185,
    );

    ctx.moveTo(
      771.25 + Math.cos(theta + Math.PI + 0.15) * 190,
      220 + Math.sin(theta + Math.PI + 0.15) * 190,
    );
    ctx.lineTo(
      771.25 + Math.cos(theta + Math.PI + 0.1) * 195,
      220 + Math.sin(theta + Math.PI + 0.1) * 195,
    );

    ctx.stroke();

    ctx.lineWidth = 5;

    //Connector Flywheel-rod Right
    ctx.strokeStyle = "DarkGreen";
    ctx.setLineDash([4, 4]);
    ctx.beginPath();

    ctx.moveTo(771.2, 220);
    ctx.lineTo(
      771.25 + Math.cos(theta) * radius,
      220 + Math.sin(theta) * radius,
    );

    ctx.stroke();
    ctx.setLineDash([]);

    //Angle
    ctx.lineWidth = 1;
    ctx.fillStyle = "rgba(0, 100, 0, 0.5)";

    ctx.beginPath();
    ctx.moveTo(771.2, 220)
    ctx.arc(771.2, 220, radius, 0, theta)
    ctx.stroke();
    ctx.fill();



    //Mast Left
    ctx.lineWidth = 5;
    ctx.fillStyle = "#404040";

    ctx.fillRect(192.5, 420, 15, 650 - 250);

    //Hot Air
    ctx.lineWidth = 8;
    ctx.fillStyle = "lightCoral";

    ctx.fillRect(
      20,
      980 - radius + h_Displacer - 20,
      417.5,
      radius - h_Displacer + 20,
    ); //+ and - 20 so the areas overlapp to fix flickering

    ctx.fillRect(
      562.5,
      980 - radius + h_Displacer - 20,
      417.5,
      radius - h_Displacer + 20,
    );

    //Cold Air
    ctx.fillStyle = "lightBlue";

    ctx.fillRect(20, 820, 417.5, radius + h_Displacer + 20);

    ctx.fillRect(562.5, 820, 417.5, radius + h_Displacer + 20);

    //Gradient
    ctx.lineWidth = 1;
    const grad = ctx.createLinearGradient(
      20,
      h_Displacer + 860,
      20,
      h_Displacer + 860 + 2 * radius,
    );
    grad.addColorStop(0, "lightblue");
    grad.addColorStop(1, "lightCoral");

    ctx.fillStyle = grad;
    ctx.fillRect(20, h_Displacer + 860, 417.5, 80);

    ctx.fillRect(562.5, h_Displacer + 860, 417.5, 80);

    //Displacer
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.fillStyle = "DarkGreen";

    ctx.rect(30, h_Displacer + 860, 397.5, 80);

    ctx.rect(572.5, h_Displacer + 860, 397.5, 80);

    ctx.fill();

    //Cooler
    ctx.lineWidth = 8;
    ctx.beginPath();
    ctx.strokeStyle = "blue";

    ctx.moveTo(20, 820);
    ctx.lineTo(437.5, 820);

    ctx.moveTo(562.5, 820);
    ctx.lineTo(980, 820);

    ctx.stroke();

    //Heater
    ctx.beginPath();
    ctx.strokeStyle = "DarkRed";

    ctx.moveTo(20, 980);
    ctx.lineTo(437.5, 980);

    ctx.moveTo(562.5, 980);
    ctx.lineTo(980, 980);

    ctx.stroke();

    //Walls
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.strokeStyle = "Black";

    ctx.moveTo(20, 820);
    ctx.lineTo(20, 980);
    ctx.moveTo(437.5, 820);
    ctx.lineTo(437.5, 980);

    ctx.moveTo(562.5, 820);
    ctx.lineTo(562.5, 980);
    ctx.moveTo(980, 820);
    ctx.lineTo(980, 980);

    ctx.stroke();

    //Connecting rod Rigt I
    ctx.lineWidth = 5;

    const rodStartX = 771.25 + Math.cos(theta) * radius;
    const rodStartY = 220 + Math.sin(theta) * radius;
    const rodEndX = 572.5 + 397.5 / 2;
    const rodEndY = h_Displacer + 860;
    const flywheelX = 771.25;
    const flywheelY = 220;
    const flywheelRadius = 200;

    const rodDX = rodEndX - rodStartX;
    const rodDY = rodEndY - rodStartY;
    const relativeX = rodStartX - flywheelX;
    const relativeY = rodStartY - flywheelY;

    const a = rodDX ** 2 + rodDY ** 2;
    const b = 2 * (relativeX * rodDX + relativeY * rodDY);
    const c = relativeX ** 2 + relativeY ** 2 - flywheelRadius ** 2;

    const intersectionValues = [
      (-b - Math.sqrt(b ** 2 - 4 * a * c)) / (2 * a),
      (-b + Math.sqrt(b ** 2 - 4 * a * c)) / (2 * a),
    ];

    const intersectionT = intersectionValues.find(
      (value) => value >= 0 && value <= 1,
    );

    const intersectionX = rodStartX + intersectionT * rodDX;
    const intersectionY = rodStartY + intersectionT * rodDY;

    ctx.strokeStyle = "DarkGreen";

    ctx.beginPath();
    ctx.setLineDash([4, 4]);
    ctx.moveTo(rodStartX, rodStartY);
    ctx.lineTo(intersectionX, intersectionY);
    ctx.stroke();

    ctx.beginPath();
    ctx.setLineDash([]);
    ctx.moveTo(intersectionX, intersectionY);
    ctx.lineTo(rodEndX, rodEndY);
    ctx.stroke();

    ctx.setLineDash([]);

    //Mast Right
    ctx.lineWidth = 1;
    ctx.fillStyle = "#404040";
    ctx.fillRect(771.25 - 7.5, 420, 15, 650 - 250);

    ctx.strokeStyle = "#404040";
    ctx.fillStyle = "#404040";
    ctx.beginPath();
    ctx.arc(771.25, 220, 5, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    //Work Piston
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.fillStyle = "DarkMagenta";

    ctx.rect(80, h_Work + 700, 50, 80);

    ctx.rect(746.25, h_Work + 700, 50, 80);

    ctx.fill();

    //Walls Work Piston
    ctx.lineWidth = 1;
    ctx.strokeStyle = "Black";
    ctx.beginPath();

    ctx.moveTo(80, 820);
    ctx.lineTo(80, 820 - 4 * radius);

    ctx.moveTo(130, 820);
    ctx.lineTo(130, 820 - 4 * radius);

    ctx.moveTo(746.25, 820);
    ctx.lineTo(746.25, 820 - 4 * radius);

    ctx.moveTo(746.25 + 50, 820);
    ctx.lineTo(746.25 + 50, 820 - 4 * radius);

    ctx.stroke();

    //Connecting rod Left
    ctx.lineWidth = 5;
    ctx.strokeStyle = "DarkGreen";

    ctx.beginPath();

    ctx.moveTo(223.75, 220 - radius + h_Displacer);

    ctx.lineTo(223.75, h_Displacer + 860);

    ctx.stroke();

    //Connecting rod Right II
    ctx.lineWidth = 5;
    ctx.strokeStyle = "DarkMagenta";

    ctx.beginPath();

    ctx.moveTo(
      771.25 + Math.cos(alpha) * radius,
      220 + Math.sin(alpha) * radius,
    );
    ctx.lineTo(746.25 + 25, h_Work + 700);

    ctx.stroke();
    

    //Connector Flywheel rod Rigt II
    ctx.strokeStyle = "DarkMagenta";
    ctx.beginPath();

    ctx.moveTo(771.2, 220);
    ctx.lineTo(
      771.25 + Math.cos(alpha) * radius,
      220 + Math.sin(alpha) * radius,
    );

    ctx.stroke();

    //======================
    //p-V diagramm
    //======================
    const PlotWidth = 360;
    const PlotX = 77.5;
    const PlotY = 1062.5;

    ctx.strokeStyle = "Black";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(PlotX, PlotY);
    ctx.lineTo(PlotX + PlotWidth, PlotY);
    ctx.lineTo(PlotX + PlotWidth, PlotY + PlotWidth);
    ctx.lineTo(PlotX, PlotY + PlotWidth);
    ctx.lineTo(PlotX, PlotY);

    ctx.stroke();

    ctx.fillStyle = "black";
    ctx.font = "18px Helvetica";

    ctx.save();
    ctx.translate(10, PlotY + PlotWidth / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textBaseline = "top";
    ctx.textAlign = "center";
    ctx.fillText("Pressure p/Pa", 0, 0);
    ctx.restore();

    ctx.save();
    ctx.translate(PlotX + PlotWidth / 2, 1490);
    ctx.textBaseline = "bottom";
    ctx.textAlign = "center";
    ctx.fillText("Volume V/m³", 0, 0);
    ctx.restore();

    //Draw Diagramm
    const dp = Math.max(...Pressures) - Math.min(...Pressures);
    const dV = Math.max(...Volumes) - Math.min(...Volumes);

    ctx.fillStyle = "black";
    ctx.font = "12px Helvetica";
    const numLabels = 6;

    //Volumes labels

      for (let i = 0; i<(numLabels+1); i++){
      const label = Math.min(...Volumes) + i/(numLabels) * dV;
      ctx.save();
      ctx.translate(PlotX + 2 + (PlotWidth - 20) * (i/(numLabels)), PlotY + PlotWidth + 45);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText(label.toExponential(2), 0, 0);
      ctx.restore();
      }
    
    ctx.strokeStyle = "Grey";
    ctx.beginPath();
    for (let i = 0; i<(numLabels+1); i++){
      ctx.moveTo(PlotX + 10 + (PlotWidth - 20) * (1-i/(numLabels)), PlotY);
      ctx.lineTo(PlotX + 10 + (PlotWidth - 20) * (1-i/(numLabels)), PlotY + PlotWidth);
    }
    ctx.stroke();

    //Pressure labels
    for (let i = 0; i<(numLabels+1); i++){
      const label = Math.min(...Pressures) + i/(numLabels) * dp;
      ctx.fillText(label.toExponential(2), 35, PlotY + 2 + (PlotWidth - 20) * (1-i/(numLabels)));
      }
    
    ctx.strokeStyle = "Grey";
    ctx.beginPath();
    for (let i = 0; i<(numLabels+1); i++){
      ctx.moveTo(PlotX, PlotY + 10 + (PlotWidth - 20) * (1-i/(numLabels)));
      ctx.lineTo(PlotX+PlotWidth, PlotY + 10 + (PlotWidth - 20) * (1-i/(numLabels)));
    }
    ctx.stroke();


    //Graph
    ctx.strokeStyle = "Red";
    ctx.fillStyle = "rgba(255, 0, 0, 0.2)"
    ctx.beginPath();

    ctx.moveTo(PlotX + 10 + (PlotWidth - 20) * (Volumes[0]- Math.min(...Volumes)/dV), PlotY + 10 + (PlotWidth - 20) * (1-((Pressures[0]- Math.min(...Pressures))/dp)));

    for (let i = 1; i < Volumes.length; i++) {
        ctx.lineTo(PlotX + 10 + (PlotWidth - 20) * (Volumes[i]- Math.min(...Volumes)/dV), PlotY + 10 + (PlotWidth - 20) * (1-((Pressures[i]- Math.min(...Pressures))/dp)));
    }

    ctx.lineTo(PlotX + 10 + (PlotWidth - 20) * (Volumes[0]- Math.min(...Volumes)/dV), PlotY + 10 + (PlotWidth - 20) * (1-((Pressures[0]- Math.min(...Pressures))/dp)));
    
    ctx.fill();
    ctx.stroke();


    //Current Position
    ctx.strokeStyle = "blue";
    ctx.fillStyle = "blue";
    ctx.beginPath();
    ctx.arc(PlotX + 10 + (PlotWidth - 20) * (Volume(theta, alpha)- Math.min(...Volumes)/dV), PlotY + 10 + (PlotWidth - 20) * (1-((Pressure(theta,alpha)- Math.min(...Pressures))/dp)), 5, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    //Data
    ctx.fillStyle = "black";
    ctx.font = "18px Helvetica";
    ctx.textBaseline = "top";
    
    

    const TextX = 1000-PlotX-PlotWidth;
    const TextY = PlotY;
    const dText = 23;

    ctx.fillText("Crank angle (theta):", TextX, TextY)
    ctx.fillText("Crank angle (alpha):", TextX, TextY + dText)

  }

  //Displayed animation

  function animateCanvas(time) {
    const t = time / 1000;

    drawFrame(t);

    requestAnimationFrame(animateCanvas);
  }

  requestAnimationFrame(animateCanvas);

  //Gif Settings

  const fps = 15;
  const duration = (2 * Math.PI) / omega;

  //Create GIF

  async function makeGIF() {
    const frameCount = fps * duration;
    const delay = 1000 / fps;
    const frames = [];

    // Create every GIF frame
    for (let frame = 0; frame < frameCount; frame++) {
      const t = frame / fps;

      drawFrame(t);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);

      frames.push({
        data: imageData.data,
        delay: delay,
      });
    }

    // Encode frames into GIF
    const output = await encode({
      workerUrl,
      width: canvas.width,
      height: canvas.height,
      frames: frames,
    });

    // Turn GIF bytes into a Blob
    const blob = new Blob([output], {
      type: "image/gif",
    });

    // Create temporary browser URL
    return URL.createObjectURL(blob);
  }

  // Download Button
  const downloadButton = document.getElementById("downloadGif");
  const gifStatus = document.getElementById("gifStatus");

  downloadButton.addEventListener("click", async () => {
    downloadButton.disabled = true;
    downloadButton.textContent = "Creating GIF...";
    gifStatus.textContent = "Encoding GIF...";

    try {
      // Generate GIF
      const gifURL = await makeGIF();
      // Create temporary download link
      const link = document.createElement("a");

      link.href = gifURL;
      link.download = "stirling-animation.gif";
      document.body.appendChild(link);
      // Start download
      link.click();
      // Remove temporary link
      link.remove();
      // Remove temporary Blob URL later
      setTimeout(() => {
        URL.revokeObjectURL(gifURL);
      }, 1000);

      gifStatus.textContent = "Finished.";
    } catch (error) {
      console.error(error);
      gifStatus.textContent = "GIF creation failed.";
    } finally {
      downloadButton.disabled = false;
      downloadButton.textContent = "Download GIF";
    }
  });
</script>
