<canvas id="canvas" width="1000" height="1500"></canvas>

<button id="downloadGif"> Download GIF </button>

<p id="gifStatus"></p>

<script>
  import { encode } from "modern-gif";
  import workerUrl from "modern-gif/worker?url";

  //Canvas
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  //Physics Constants
  const omega = 1;
  const radius = 40;

  function drawFrame(t) {
    const theta = (omega * t) % (2 * Math.PI);
    const alpha = (theta - Math.PI / 2) % (2 * Math.PI);
    const h_Displacer = Math.sin(theta) * radius;
    const h_Work = Math.sin(alpha) * radius;

    ctx.fillStyle = "rgb(255 255 255)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    //Connecting rod Left
    ctx.strokeStyle = "Black";

    ctx.beginPath();

    ctx.moveTo(223.75, 220 - radius + h_Displacer);
    ctx.lineTo(223.75, h_Displacer + 860 );

    ctx.moveTo(105, 220 - radius + h_Work);
    ctx.lineTo(105, h_Work + 700 );

    ctx.stroke()

    //Flywheel Left
    ctx.fillStyle = "lightBlue";
    ctx.fillRect(190, 20, 20, 400);
    ctx.strokeStyle = "blue";
    ctx.strokeRect(190, 20, 20, 400);

    //Arrow Left
    ctx.strokeStyle = "Black";

    ctx.moveTo(200, 30);
    ctx.lineTo(200, 60);
    ctx.lineTo(195, 55);
    ctx.moveTo(200, 60);
    ctx.lineTo(205, 55);

    ctx.moveTo(200, 30+350);
    ctx.lineTo(200, 60+350);
    ctx.lineTo(195, 55+350);
    ctx.moveTo(200, 60+350);
    ctx.lineTo(205, 55+350);

    ctx.stroke()

    
    //Connector Flywheel-rod Left
    ctx.strokeStyle = "Black";

    ctx.beginPath();

    ctx.moveTo(210, 220 - radius + h_Displacer);
    ctx.lineTo(223.75, 220 - radius + h_Displacer);

    ctx.stroke()

    ctx.beginPath();

    ctx.moveTo(190, 220 - radius + h_Work);
    ctx.lineTo(130-25, 220 - radius + h_Work);

    ctx.stroke()


    //Flywheel Right
    ctx.strokeStyle = "blue";
    ctx.fillStyle = "lightBlue";

    ctx.beginPath();
    ctx.arc(771.25, 220, 200, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(771.25, 220, 180, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    //Arrow Right

    ctx.strokeStyle = "Black";

    ctx.beginPath();
    ctx.arc(771.25, 220, 190, theta, theta +0.15);
    ctx.moveTo(771.25 + Math.cos(theta +0.15) * 190, 220 + Math.sin(theta +0.15) * 190)
    ctx.lineTo(771.25 + Math.cos(theta +0.1) * 185, 220 + Math.sin(theta +0.1) * 185)

    ctx.moveTo(771.25 + Math.cos(theta +0.15) * 190, 220 + Math.sin(theta +0.15) * 190)
    ctx.lineTo(771.25 + Math.cos(theta +0.1) * 195, 220 + Math.sin(theta +0.1) * 195)
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(771.25, 220, 190, theta + Math.PI, theta + Math.PI + 0.15);
    ctx.moveTo(771.25 + Math.cos(theta + Math.PI +0.15) * 190, 220 + Math.sin(theta + Math.PI +0.15) * 190)
    ctx.lineTo(771.25 + Math.cos(theta + Math.PI +0.1) * 185, 220 + Math.sin(theta + Math.PI +0.1) * 185)

    ctx.moveTo(771.25 + Math.cos(theta + Math.PI +0.15) * 190, 220 + Math.sin(theta + Math.PI +0.15) * 190)
    ctx.lineTo(771.25 + Math.cos(theta + Math.PI +0.1) * 195, 220 + Math.sin(theta + Math.PI +0.1) * 195)

    ctx.stroke();



    //Connector Flywheel-rod Right
    ctx.strokeStyle = "Red";
    ctx.setLineDash([4, 4]);
    ctx.beginPath();

    ctx.moveTo(771.2, 220);
    ctx.lineTo(771.25 + Math.cos(theta) * radius, 220 + Math.sin(theta) * radius);

    ctx.stroke()

    ctx.strokeStyle = "Green";
    ctx.setLineDash([]);
    ctx.beginPath();

    ctx.moveTo(771.2, 220);
    ctx.lineTo(771.25 + Math.cos(alpha) * radius, 220 + Math.sin(alpha) * radius);

    ctx.stroke()




    //Mast Left
    ctx.fillStyle = "#404040";

    ctx.fillRect(192.5, 420, 15, 650-250);


    //Hot Air
    ctx.fillStyle = "lightCoral";

    ctx.fillRect(20, 980 - radius + h_Displacer -20, 417.5, radius - h_Displacer +20); //+ and - 20 so the areas overlapp to fix flickering

    ctx.fillRect(562.5, 980 - radius + h_Displacer -20, 417.5, radius - h_Displacer +20);

    //Cold Air
    ctx.fillStyle = "lightBlue";

    ctx.fillRect(20, 820, 417.5, radius + h_Displacer +20);

    ctx.fillRect(562.5, 820, 417.5, radius + h_Displacer +20); 


    //Gradient
    const grad = ctx.createLinearGradient(20, h_Displacer + 860, 20, h_Displacer + 860 + 2*radius);
    grad.addColorStop(0, "lightblue");
    grad.addColorStop(1, "lightCoral");

    ctx.fillStyle = grad;
    ctx.fillRect(20, h_Displacer + 860, 417.5, 80);

    ctx.fillRect(562.5, h_Displacer + 860, 417.5, 80);

    //Displacer
    ctx.beginPath();
    ctx.fillStyle = "Grey";

    ctx.rect(30, h_Displacer + 860, 397.5, 80);

    ctx.rect(572.5, h_Displacer + 860, 397.5, 80);

    ctx.fill();

    //Cooler
    ctx.beginPath();
    ctx.strokeStyle = "blue";

    ctx.moveTo(20, 820);
    ctx.lineTo(437.5, 820);

    ctx.moveTo(562.5, 820);
    ctx.lineTo(980, 820);

    ctx.stroke();

    //Heater
    ctx.beginPath();
    ctx.strokeStyle = "DarkRed";

    ctx.moveTo(20, 980);
    ctx.lineTo(437.5, 980);

    ctx.moveTo(562.5, 980);
    ctx.lineTo(980, 980);

    ctx.stroke();

    //Walls
    ctx.beginPath();
    ctx.strokeStyle = "Black";

    ctx.moveTo(20, 820);
    ctx.lineTo(20, 980);
    ctx.moveTo(437.5, 820);
    ctx.lineTo(437.5, 980);

    ctx.moveTo(562.5, 820);
    ctx.lineTo(562.5, 980);
    ctx.moveTo(980, 820);
    ctx.lineTo(980, 980);

    ctx.stroke();

    //Connecting rod Rigt I

    const rodStartX = 771.25 + Math.cos(theta) * radius;
    const rodStartY = 220 + Math.sin(theta) * radius;
    const rodEndX = 572.5 + 397.5 / 2;
    const rodEndY = h_Displacer + 860;
    const flywheelX = 771.25;
    const flywheelY = 220;
    const flywheelRadius = 200;

    const rodDX = rodEndX - rodStartX;
    const rodDY = rodEndY - rodStartY;
    const relativeX = rodStartX - flywheelX;
    const relativeY = rodStartY - flywheelY;

    const a = rodDX ** 2 + rodDY ** 2;
    const b = 2 * (relativeX * rodDX + relativeY * rodDY);
    const c =
      relativeX ** 2 +
      relativeY ** 2 -
      flywheelRadius ** 2;

    const intersectionValues = [
    (-b - Math.sqrt(b ** 2 - 4 * a * c)) / (2 * a),
    (-b + Math.sqrt(b ** 2 - 4 * a * c)) / (2 * a),
    ];

    const intersectionT = intersectionValues.find(
      (value) => value >= 0 && value <= 1
    );

    const intersectionX = rodStartX + intersectionT * rodDX;
    const intersectionY = rodStartY + intersectionT * rodDY;

    ctx.strokeStyle = "red";

    ctx.beginPath();
    ctx.setLineDash([4, 4]);
    ctx.moveTo(rodStartX, rodStartY);
    ctx.lineTo(intersectionX, intersectionY);
    ctx.stroke();

    ctx.beginPath();
    ctx.setLineDash([]);
    ctx.moveTo(intersectionX, intersectionY);
    ctx.lineTo(rodEndX, rodEndY);
    ctx.stroke();

    //Mast Right
    ctx.fillStyle = "#404040";
    ctx.fillRect(771.25-7.5, 420, 15, 650-250);

    ctx.strokeStyle = "#404040";
    ctx.fillStyle = "#404040";
    ctx.beginPath();
    ctx.arc(771.25, 220, 5, 0, 2 * Math.PI);
    ctx.fill();
    ctx.stroke();

    //Work Piston
    ctx.beginPath();
    ctx.fillStyle = "Grey";

    ctx.rect(80, h_Work + 700, 50, 80);

    ctx.rect(746.25, h_Work + 700, 50, 80);

    ctx.fill();

    //Walls Work Piston
    ctx.strokeStyle = "Black";
    ctx.beginPath();

    ctx.moveTo(80, 820);
    ctx.lineTo(80, 820- 4 * radius);

    ctx.moveTo(130, 820);
    ctx.lineTo(130, 820- 4 * radius);

    ctx.moveTo(746.25, 820);
    ctx.lineTo(746.25, 820- 4 * radius);

    ctx.moveTo(746.25+50, 820);
    ctx.lineTo(746.25+50, 820- 4 * radius);

    ctx.stroke();

    //Connecting rod Left
    ctx.strokeStyle = "Black";

    ctx.beginPath();

    ctx.moveTo(223.75, 220 - radius + h_Displacer);

    ctx.lineTo(223.75, h_Displacer + 860 );

    ctx.stroke()

    //Connecting rod Right II
    ctx.strokeStyle = "Green";

    ctx.beginPath();

    ctx.moveTo(771.25 + Math.cos(alpha) * radius, 220 + Math.sin(alpha) * radius);
    ctx.lineTo(746.25+25,  h_Work + 700);

    ctx.stroke()




    //



  }


  //Displayed animation

  function animateCanvas(time) {
    const t = time / 1000;

    drawFrame(t);

    requestAnimationFrame(animateCanvas);
  }

  requestAnimationFrame(animateCanvas);

  //Gif Settings

  const fps = 15;
  const duration = 2*Math.PI/omega;

  //Create GIF

  async function makeGIF() {
    const frameCount = fps * duration;
    const delay = 1000 / fps;
    const frames = [];

    // Create every GIF frame
    for (let frame = 0; frame < frameCount; frame++) {
      const t = frame / fps;

      drawFrame(t);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);

      frames.push({
        data: imageData.data,
        delay: delay,
      });
    }

    // Encode frames into GIF
    const output = await encode({
      workerUrl,
      width: canvas.width,
      height: canvas.height,
      frames: frames,
    });

    // Turn GIF bytes into a Blob
    const blob = new Blob([output], {
      type: "image/gif",
    });

    // Create temporary browser URL
    return URL.createObjectURL(blob);
  }

  // Download Button
  const downloadButton = document.getElementById("downloadGif");
  const gifStatus = document.getElementById("gifStatus");

  downloadButton.addEventListener("click", async () => {
    downloadButton.disabled = true;
    downloadButton.textContent = "Creating GIF...";
    gifStatus.textContent = "Encoding GIF...";

    try {
      // Generate GIF
      const gifURL = await makeGIF();
      // Create temporary download link
      const link = document.createElement("a");

      link.href = gifURL;
      link.download = "stirling-animation.gif";
      document.body.appendChild(link);
      // Start download
      link.click();
      // Remove temporary link
      link.remove();
      // Remove temporary Blob URL later
      setTimeout(() => {
        URL.revokeObjectURL(gifURL);
      }, 1000);

      gifStatus.textContent = "Finished.";
    } catch (error) {
      console.error(error);
      gifStatus.textContent = "GIF creation failed.";
    } finally {
      downloadButton.disabled = false;
      downloadButton.textContent = "Download GIF";
    }
  });
</script>
