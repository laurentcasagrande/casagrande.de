<svg width="600" height="500"
     xmlns="http://www.w3.org/2000/svg">

  <rect  width="100%" height="100%" fill="grey"/>

  <circle id="VerdraengerKolben" r="80" fill="green">
    <animate
        attributeName="cy" 
        values="50;150"
        dur="3s"
        repeatCount="indefinite" />
    />
  </circle>

  <line x1="2%" y1="98%" x2="43.75%" y2="98%" stroke="red" /> <!-- Heater Left -->
  <line x1="56.25%" y1="98%" x2="98%" y2="98%" stroke="red" /> <!-- Heater Left -->

  <text x="150" y="125" font-size="60" text-anchor="middle" fill="white">SVG</text>

</svg>

<script>
  const rect = document.getElementById("VerdraengerKolben");

  function animate(time) {
    const t = time / 1000;

    const cx = 2.5 + 25 * Math.sin(t);

    rect.setAttribute("cx", cx);

    requestAnimationFrame(animate);
  }

  requestAnimationFrame(animate);
</script>