---
import BaseLayout from "./BaseLayout.astro";
import MarkdownFooter from "../components/FooterMarkdown.astro"
import ArticleNavigation from "../components/ArticleNavigation.astro";
const { frontmatter, headings = [] } = Astro.props;
// Set `toc: false` in a post's frontmatter to hide it.
const showToc = Astro.url.pathname.startsWith('/posts/') && frontmatter.toc !== false;
import 'katex/dist/katex.min.css';
---

<BaseLayout>
    <main class="blog-post">
        <article class="markdown-content">
            <h1 id="article-top" tabindex="-1">{frontmatter.title}</h1>
            {showToc && <ArticleNavigation headings={headings} />}
            <slot />
        </article>
    </main>
    <MarkdownFooter slot="footer" />
</BaseLayout>

<style>
  .markdown-content {
    padding-bottom: 1em;
  }
</style>
